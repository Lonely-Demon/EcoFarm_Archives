# Comma-separated list of browser origins allowed to call this API.
ECOFARM_ALLOWED_ORIGINS=https://your-frontend.example.org,http://localhost:3000
# Set to true ONLY behind a locked-down staging environment.
ECOFARM_ALLOW_ALL_ORIGINS=false
ECOFARM_DATABASE_PATH=data/decisions.db
ECOFARM_ENVIRONMENT=production
