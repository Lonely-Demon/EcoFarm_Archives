# Leave NEXT_PUBLIC_API_BASE_URL empty to use the built-in /api/proxy rewrite.
# For a separately hosted backend, set it to the public FastAPI origin:
# NEXT_PUBLIC_API_BASE_URL=https://ecofarm-api.example.org
NEXT_PUBLIC_API_BASE_URL=

# Only used by the rewrite when NEXT_PUBLIC_API_BASE_URL is empty.
API_PROXY_TARGET=http://127.0.0.1:8000
