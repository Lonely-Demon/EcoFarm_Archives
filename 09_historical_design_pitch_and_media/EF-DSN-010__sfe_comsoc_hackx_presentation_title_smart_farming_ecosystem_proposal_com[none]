" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z\"/>\n                </svg>\n              </div>\n              <div class=\"revenue-name\">Tiered Subscriptions</div>\n              <div class=\"revenue-description\">Based on farm size and feature access</div>\n            </div>\n            <div class=\"revenue-option\">\n              <div class=\"revenue-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\"/>\n                </svg>\n              </div>\n              <div class=\"revenue-name\">Hardware Sales</div>\n              <div class=\"revenue-description\">Sensors, controllers, and maintenance services</div>\n            </div>\n            <div class=\"revenue-option\">\n              <div class=\"revenue-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z\"/>\n                </svg>\n              </div>\n              <div class=\"revenue-name\">Data Marketplace</div>\n              <div class=\"revenue-description\">Insights for agricultural stakeholders and researchers</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration top-right\">\n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration bottom-left\">\n    </div>\n    \n    <div class=\"footer\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n  </div>\n</body>\n</html>\n"},{"id":"blank_slide","path":"/home/ubuntu/sfe_comsoc_hackx_presentation/blank_slide.html","changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Smart Farming Ecosystem - Blank Slide</title>\n  <style>\n    body, html {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Arial', sans-serif;\n    }\n    .slide {\n      width: 1440px;\n      height: 810px;\n      background: #000;\n      background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1440\" height=\"810\" viewBox=\"0 0 1440 810\"><rect width=\"1440\" height=