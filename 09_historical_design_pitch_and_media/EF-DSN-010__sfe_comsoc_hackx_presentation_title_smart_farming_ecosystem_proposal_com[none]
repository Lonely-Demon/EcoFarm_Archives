direction: column;\n      padding: 40px;\n      position: relative;\n      z-index: 1;\n    }\n    .logo {\n      height: 60px;\n      margin: 0 10px;\n    }\n    .title {\n      font-size: 60px;\n      font-weight: bold;\n      margin-bottom: 40px;\n      text-align: center;\n      background: linear-gradient(45deg, #ffffff, #a64dff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 10px rgba(166, 77, 255, 0.3);\n    }\n    .future-content {\n      display: flex;\n      flex-direction: column;\n      gap: 30px;\n    }\n    .future-point {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 15px;\n    }\n    .bullet {\n      color: #a64dff;\n      font-size: 24px;\n      margin-right: 15px;\n      margin-top: 5px;\n    }\n    .point-text {\n      font-size: 24px;\n      color: white;\n      line-height: 1.5;\n    }\n    .roadmap {\n      margin-top: 20px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n    }\n    .roadmap-title {\n      font-size: 24px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      text-align: center;\n    }\n    .phases {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 20px;\n    }\n    .phase {\n      width: 22%;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 15px;\n      text-align: center;\n    }\n    .phase-number {\n      font-size: 24px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 10px;\n    }\n    .phase-title {\n      font-size: 18px;\n      font-weight: bold;\n      color: white;\n      margin-bottom: 10px;\n    }\n    .phase-description {\n      font-size: 14px;\n      color: #ccc;\n    }\n    .future-features {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 20px;\n    }\n    .feature-column {\n      width: 48%;\n    }\n    .feature-title {\n      font-size: 20px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      border-bottom: 1px solid rgba(166, 77, 255, 0.5);\n      padding-bottom: 5px;\n    }\n    .feature-item {\n      display: flex;\n      align-items: center;\n      margin-bottom: 10px;\n    }\n    .feature-icon {\n      width: 30px;\n      height: 30px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-right: 15px;\n    }\n    .feature-text {\n      font-size: 16px;\n      color: white;\n    }\n    .revenue-model {\n      margin-top: 20px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n    }\n    .revenue-title {\n      font-size: 20px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      text-align: center;\n    }\n    .revenue-options {\n      display: flex;\n      justify-content: space-between;\n    }\n    .revenue-option {\n      width: 30%;\n      text-align: center;\n      padding: 10px;\n    }\n    .revenue-icon {\n      width: 40px;\n      height: 40px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0 auto 10px;\n    }\n    .revenue-name {\n      font-size: 18px;\n      font-weight: bold;\n      color: white;\n      margin-bottom: 5px;\n    }\n    .revenue-description {\n      font-size: 14px;\n      color: #ccc;\n    }\n    .track-tags {\n      display: flex;\n      justify-content: center;\n      gap: 20px;\n      margin-top: 20px;\n    }\n    .track-tag {\n      background-color: rgba(166, 77, 255, 0.3);\n      color: white;\n      font-size: 16px;\n      font-weight: bold;\n      padding: 8px 15px;\n      border-radius: 20px;\n      display: flex;\n      align-items: center;\n    }\n    .tag-icon {\n      margin-right: 8px;\n    }\n    .decoration {\n      position: absolute;\n      width: 100px;\n      height: 100px;\n      opacity: 0.5;\n    }\n    .decoration.top-right {\n      top: 100px;\n      right: 100px;\n      transform: rotate(45deg);\n    }\n    .decoration.bottom-left {\n      bottom: 100px;\n      left: 100px;\n      transform: rotate(-45deg);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"header\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n    \n    <div class=\"content\">\n      <h1 class=\"title\">FUTURE SCOPE</h1>\n      \n      <div class=\"track-tags\">\n        <div class=\"track-tag\">\n          <span class=\"tag-icon\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#fff\">\n              <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n            </svg>\n          </span>\n          AI/ML Track\n        </div>\n        <div class=\"track-tag\">\n          <span class=\"tag-icon\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#fff\">\n              <path d=\"M7 5h10v2h2V3c0-1.1-.9-1.99-2-1.99L7 1c-1.1 0-2 .9-2 2v4h2V5zm8.41 11.59L20 12l-4.59-4.59L14 8.83 17.17 12 14 15.17l1.41 1.42zM10 15.17L6.83 12 10 8.83 8.59 7.41 4 12l4.59 4.59L10 15.17zM17 19H7v-2H5v4c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-4h-2v2z\"/>\n            </svg>\n          </span>\n          IoT Track\n        </div>\n        <div class=\"track-tag\">\n          <span class=\"tag-icon\">\n            <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#fff\">\n              <path d=\"M12 22c4.97 0 9-4.03 9-9-4.97 0-9 4.03-9 9zM5.6 10.25c0 1.38 1.12 2.5 2.5 2.5.53 0 1.01-.16 1.42-.44l-.02.19c0 1.38 1.12 2.5 2.5 2.5s2.5-1.12 2.5-2.5l-.02-.19c.4.28.89.44 1.42.44 1.38 0 2.5-1.12 2.5-2.5 0-1-.59-1.85-1.43-2.25.84-.4 1.43-1.25 1.43-2.25 0-1.38-1.12-2.5-2.5-2.5-.53 0-1.01.16-1.42.44l.02-.19C14.5 2.12 13.38 1 12 1S9.5 2.12 9.5 3.5l.02.19c-.4-.28-.89-.44-1.42-.44-1.38 0-2.5 1.12-2.5 2.5 0 1 .59 1.85 1.43 2.25-.84.4-1.43 1.25-1.43 2.25zM12 5.5c1.38 0 2.5 1.12 2.5 2.5s-1.12 2.5-2.5 2.5S9.5 9.38 9.5 8s1.12-2.5 2.5-2.5zM3 13c0 4.97 4.03 9 9 9 0-4.97-4.03-9-9-9z\"/>\n            </svg>\n          </span>\n          Sustainable Development\n        </div>\n      </div>\n      \n      <div class=\"future-content\">\n        <div class=\"roadmap\">\n          <div class=\"roadmap-title\">Growth Roadmap</div>\n          <div class=\"phases\">\n            <div class=\"phase\">\n              <div class=\"phase-number\">Phase 1</div>\n              <div class=\"phase-title\">MVP Launch</div>\n              <div class=\"phase-description\">Core mobile app with basic sensor integration and AI recommendations</div>\n            </div>\n            <div class=\"phase\">\n              <div class=\"phase-number\">Phase 2</div>\n              <div class=\"phase-title\">Enhanced Sensing</div>\n              <div class=\"phase-description\">Expanded sensor types and advanced analytics capabilities</div>\n            </div>\n            <div class=\"phase\">\n              <div class=\"phase-number\">Phase 3</div>\n              <div class=\"phase-title\">Drone Integration</div>\n              <div class=\"phase-description\">Aerial imaging and targeted treatment application</div>\n            </div>\n            <div class=\"phase\">\n              <div class=\"phase-number\">Phase 4</div>\n              <div class=\"phase-title\">Satellite Integration</div>\n              <div class=\"phase-description\">Multi-sensor satellite constellation for large-scale monitoring</div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"future-features\">\n          <div class=\"feature-column\">\n            <div class=\"feature-title\">Planned Feature Expansions</div>\n            <div class=\"feature-item\">\n              <div class=\"feature-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z\"/>\n                </svg>\n              </div>\n              <div class=\"feature-text\">Community marketplace for direct farmer-to-consumer sales</div>\n            </div>\n            <div class=\"feature-item\">\n              <div class=\"feature-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M7 5h10v2h2V3c0-1.1-.9-1.99-2-1.99L7 1c-1.1 0-2 .9-2 2v4h2V5zm8.41 11.59L20 12l-4.59-4.59L14 8.83 17.17 12 14 15.17l1.41 1.42zM10 15.17L6.83 12 10 8.83 8.59 7.41 4 12l4.59 4.59L10 15.17zM17 19H7v-2H5v4c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-4h-2v2z\"/>\n                </svg>\n              </div>\n              <div class=\"feature-text\">Integration with agricultural equipment for automated precision operations</div>\n            </div>\n            <div class=\"feature-item\">\n              <div class=\"feature-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n                </svg>\n              </div>\n              <div class=\"feature-text\">Weather prediction models specific to microclimate conditions</div>\n            </div>\n          </div>\n          \n          <div class=\"feature-column\">\n            <div class=\"feature-title\">Advanced AI & Satellite Capabilities</div>\n            <div class=\"feature-item\">\n              <div class=\"feature-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z\"/>\n                </svg>\n              </div>\n              <div class=\"feature-text\">Hyperspectral, multispectral, and SAR satellite imaging for comprehensive monitoring</div>\n            </div>\n            <div class=\"feature-item\">\n              <div class=\"feature-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M21.11 2.89L21.11 2.89c-.46-.46-1.11-.78-1.81-.78h-1.2c-.67 0-1.35.33-1.81.8L14 5.12l-4.24.35L8.51 2.2C8.19 1.29 7.21 1 6.5 1c-.66 0-1.3.27-1.77.76L3.9 2.6c-.92.95-.92 2.47.02 3.42l1.63 1.6L2 10.12l3.37 3.37c.2.2.51.2.71 0l1.62-1.61 1.62 1.61c.2.2.51.2.71 0l3.36-3.36