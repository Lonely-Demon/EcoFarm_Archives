,300 T1100,300\" stroke=\"rgba(128,0,255,0.15)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M100,400 Q300,250 500,400 T900,400\" stroke=\"rgba(128,0,255,0.1)\" stroke-width=\"5\" fill=\"none\"/></svg>');\n      position: relative;\n      color: white;\n      display: flex;\n      flex-direction: column;\n    }\n    .header {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-bottom: 1px solid rgba(128,0,255,0.3);\n    }\n    .footer {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-top: 1px solid rgba(128,0,255,0.3);\n      margin-top: auto;\n    }\n    .content {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding: 40px;\n      position: relative;\n      z-index: 1;\n    }\n    .logo {\n      height: 60px;\n      margin: 0 10px;\n    }\n    .title {\n      font-size: 60px;\n      font-weight: bold;\n      margin-bottom: 40px;\n      text-align: center;\n      background: linear-gradient(45deg, #ffffff, #a64dff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 10px rgba(166, 77, 255, 0.3);\n    }\n    .methodology-content {\n      display: flex;\n      flex-direction: column;\n      gap: 30px;\n    }\n    .methodology-point {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 15px;\n    }\n    .bullet {\n      color: #a64dff;\n      font-size: 24px;\n      margin-right: 15px;\n      margin-top: 5px;\n    }\n    .point-text {\n      font-size: 24px;\n      color: white;\n      line-height: 1.5;\n    }\n    .tech-stack {\n      display: flex;\n      justify-content: space-between;\n      margin: 20px 0;\n    }\n    .tech-column {\n      width: 48%;\n    }\n    .tech-category {\n      font-size: 24px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      border-bottom: 1px solid rgba(166, 77, 255, 0.5);\n      padding-bottom: 5px;\n    }\n    .tech-item {\n      display: flex;\n      align-items: center;\n      margin-bottom: 10px;\n    }\n    .tech-icon {\n      width: 40px;\n      height: 40px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-right: 15px;\n    }\n    .tech-name {\n      font-size: 20px;\n      font-weight: bold;\n      color: white;\n    }\n    .tech-description {\n      font-size: 16px;\n      color: #ccc;\n    }\n    .system-flow {\n      margin-top: 20px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n    }\n    .flow-title {\n      font-size: 24px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      text-align: center;\n    }\n    .flow-diagram {\n      display: flex;\n      justify-content: space-between;\n      align-items: center;\n      margin-top: 20px;\n    }\n    .flow-element {\n      width: 120px;\n      height: 80px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n      text-align: center;\n      padding: 10px;\n    }\n    .flow-arrow {\n      width: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #a64dff;\n      font-size: 24px;\n    }\n    .decoration {\n      position: absolute;\n      width: 100px;\n      height: 100px;\n      opacity: 0.5;\n    }\n    .decoration.top-right {\n      top: 100px;\n      right: 100px;\n      transform: rotate(45deg);\n    }\n    .decoration.bottom-left {\n      bottom: 100px;\n      left: 100px;\n      transform: rotate(-45deg);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"header\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n    \n    <div class=\"content\">\n      <h1 class=\"title\">METHODOLOGY AND IMPLEMENTATION</h1>\n      \n      <div class=\"methodology-content\">\n        <div class=\"methodology-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Detail the tech stack, including programming languages, frameworks, APIs, and databases.</div>\n        </div>\n        \n        <div class=\"tech-stack\">\n          <div class=\"tech-column\">\n            <div class=\"tech-category\">Frontend & Mobile</div>\n            <div class=\"tech-item\">\n              <div class=\"tech-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n                </svg>\n              </div>\n              <div>\n                <div class=\"tech-name\">Flutter</div>\n                <div class=\"tech-description\">Cross-platform development with excellent UI capabilities</div>\n              </div>\n            </div>\n            \n            <div class=\"tech-category\">Backend & API</div>\n            <div class=\"tech-item\">\n              <div class=\"tech-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0l4.6-4.6-4.6-4.6L16 6l6 6-6 6-1.4-1.4z\"/>\n                </svg>\n              </div>\n              <div>\n                <div class=\"tech-name\">Python with FastAPI</div>\n                <div class=\"tech-description\">High-performance API framework with AI/ML ecosystem</div>\n              </div>\n            </div>\n          </div>\n          \n          <div class=\"tech-column\">\n            <div class=\"tech-category\">Database & Storage</div>\n            <div class=\"tech-item\">\n              <div class=\"tech-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/>\n                </svg>\n              </div>\n              <div>\n                <div class=\"tech-name\">PostgreSQL with Extensions</div>\n                <div class=\"tech-description\">PostGIS for geospatial & TimescaleDB for time-series data</div>\n              </div>\n            </div>\n            \n            <div class=\"tech-category\">IoT & Sensor Integration</div>\n            <div class=\"tech-item\">\n              <div class=\"tech-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M7 5h10v2h2V3c0-1.1-.9-1.99-2-1.99L7 1c-1.1 0-2 .9-2 2v4h2V5zm8.41 11.59L20 12l-4.59-4.59L14 8.83 17.17 12 14 15.17l1.41 1.42zM10 15.17L6.83 12 10 8.83 8.59 7.41 4 12l4.59 4.59L10 15.17zM17 19H7v-2H5v4c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2v-4h-2v2z\"/>\n                </svg>\n              </div>\n              <div>\n                <div class=\"tech-name\">Custom IoT Sensor Network</div>\n                <div class=\"tech-description\">Arduino-based nodes with LoRaWAN/MQTT protocols</div>\n              </div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"methodology-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Present a high-level system flow diagram to explain how different parts of the solution connect.</div>\n        </div>\n        \n        <div class=\"system-flow\">\n          <div class=\"flow-title\">System Architecture Flow</div>\n          <div class=\"flow-diagram\">\n            <div class=\"flow-element\">\n              <div>IoT Sensors</div>\n              <div style=\"font-size: 12px\">Data Collection</div>\n            </div>\n            <div class=\"flow-arrow\">→</div>\n            <div class=\"flow-element\">\n              <div>Cloud Backend</div>\n              <div style=\"font-size: 12px\">Data Processing</div>\n            </div>\n            <div class=\"flow-arrow\">→</div>\n            <div class=\"flow-element\">\n              <div>AI Engine</div>\n              <div style=\"font-size: 12px\">Analysis & Prediction</div>\n            </div>\n            <div class=\"flow-arrow\">→</div>\n            <div class=\"flow-element\">\n              <div>Mobile App</div>\n              <div style=\"font-size: 12px\">User Interface</div>\n            </div>\n            <div class=\"flow-arrow\">→</div>\n            <div class=\"flow-element\">\n              <div>Control Systems</div>\n              <div style=\"font-size: 12px\">Automated Actions</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration top-right\">\n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration bottom-left\">\n    </div>\n    \n    <div class=\"footer\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n  </div>\n</body>\n</html>\n"},{"id":"problem_statement","path":"/home/ubuntu/sfe_comsoc_hackx_presentation/problem_statement.html","changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Smart Farming Ecosystem - Problem Statement</title>\n  <style>\n    body, html {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Arial', sans-serif;\n    }\n    .slide {\n      width: 1440px;\n      height: 810px;\n      background: #000;\n      background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1440\" height=\"810\" viewBox=\"0 0 1440 810\"><rect width=\"1440\" height=\"810\" fill=\"black\"/><path d=\"M0,0 L1440,0 L1440,810 L0,810 Z\" fill=\"black\"/><path d=\"M200,200 Q400,50 600,200 T1000,200\" stroke=\"rgba(128,0,255,0.2)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M300,300 Q500,150 700,300 T1100,300\" stroke=\"rgba(128,0,255,0.15)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M100,400 Q300,250 500,400 T900,400\" stroke=\"rgba(128,0,255,0.1)\" stroke-width=\"5\" fill=\"none\"/></svg>');\n      position: relative;\n      color: white;\n      display: flex;\n      flex-direction: column;\n    }\n    .header {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-bottom: 1px solid rgba(128,0,255,0.3);\n    }\n    .footer {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-top: 1px solid rgba(128,0,255,0.3);\n      margin-top: auto;\n    }\n    .content {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding: 40px;\n      position: relative;\n      z-index: 1;\n    }\n    .logo {\n      height: 60px;\n      margin: 0 10px;\n    }\n    .title {\n      font-size: 60px;\n      font-weight: bold;\n      margin-bottom: 40px;\n      text-align: center;\n      background: linear-gradient(45deg, #ffffff, #a64dff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 10px rgba(166, 77, 255, 0.3);\n    }\n    .problem-content {\n      display: flex;\n      flex-direction: column;\n      gap: 30px;\n    }\n    .problem-point {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 15px;\n    }\n    .bullet {\n      color: #a64dff;\n      font-size: 24px;\n      margin-right: 15px;\n      margin-top: 5px;\n    }\n    .point-text {\n      font-size: 24px;\n      color: white;\n      line-height: 1.5;\n    }\n    .stats-container {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 20px;\n      margin-bottom: 20px;\n    }\n    .stat-box {\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n      width: 30%;\n      text-align: center;\n    }\n    .stat-number {\n      font-size: 36px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 10px;\n    }\n    .stat-description {\n      font-size: 18px;\n      color: white;\n    }\n    .decoration {\n      position: absolute;\n      width: 100px;\n      height: 100px;\n      opacity: 0.5;\n    }\n    .decoration.top-right {\n      top: 100px;\n      right: 100px;\n      transform: rotate(45deg);\n    }\n    .decoration.bottom-left {\n      bottom: 100px;\n      left: 100px;\n      transform: rotate(-45deg);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"header\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n    \n    <div class=\"content\">\n      <h1 class=\"title\">PROBLEM STATEMENT</h1>\n      \n      <div class=\"problem-content\">\n        <div class=\"problem-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Clearly describe the challenge your solution addresses.</div>\n        </div>\n        <div class=\"problem-point\">\n          <div class=\"bullet\"></div>\n          <div class=\"point-text\">Current agricultural practices are unsustainable and inefficient, with significant resource wastage and preventable crop losses. Traditional farming relies on reactive approaches, intervening only after problems become visible, leading to excessive resource use and reduced yields.</div>\n        </div>\n        \n        <div class=\"problem-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Explain why tackling this issue matters — highlight its impact, market need, or social significance.</div>\n        </div>\n        <div class=\"problem-point\">\n          <div class=\"bullet\"></div>\n          <div class=\"point-text\">Agriculture faces unprecedented challenges from climate change, water scarcity, and growing food demand. Inefficient practices threaten food security, farmer livelihoods, and environmental sustainability. Transforming agriculture is essential for feeding a projected 9.7 billion people by 2050 while reducing environmental impact.</div>\n        </div>\n        \n        <div class=\"stats-container\">\n          <div class=\"stat-box\">\n            <div class=\"stat-number\">30%</div>\n            <div class=\"stat-description\">of global freshwater in agriculture is wasted due to inefficient irrigation</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\">25%</div>\n            <div class=\"stat-description\">of fertilizers are overapplied or lost to runoff, costing $50 billion annually</div>\n          </div>\n          <div class=\"stat-box\">\n            <div class=\"stat-number\">20-40%</div>\n            <div class=\"stat-description\">preventable yield losses due to delayed detection of crop diseases</div>\n          </div>\n        </div>\n        \n        <div class=\"problem-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Back your points with relevant data or statistics if available.</div>\n        </div>\n        <div class=\"problem-point\">\n          <div class=\"bullet\"></div>\n          <div class=\"point-text\">According to the UN Food and Agriculture Organization (FAO), agricultural water efficiency must improve by 60% by 2030 to meet sustainable development goals. The World Economic Forum reports that precision agriculture technologies can reduce water usage by up to 30% and fertilizer application by 20%, while increasing yields by 15%.</div>\n        </div>\n      </div>\n      \n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration top-right\">\n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration bottom-left\">\n    </div>\n    \n    <div class=\"footer\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n  </div>\n</body>\n</html>\n"},{"id":"solution_overview","path":"/home/ubuntu/sfe_comsoc_hackx_presentation/solution_overview.html","changed":true,"content":"<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Smart Farming Ecosystem - Solution Overview</title>\n  <style>\n    body, html {\n      margin: 0;\n      padding: 0;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Arial', sans-serif;\n    }\n    .slide {\n      width: 1440px;\n      height: 810px;\n      background: #000;\n      background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1440\" height=\"810\" viewBox=\"0 0 1440 810\"><rect width=\"1440\" height=\"810\" fill=\"black\"/><path d=\"M0,0 L1440,0 L1440,810 L0,810 Z\" fill=\"black\"/><path d=\"M200,200 Q400,50 600,200 T1000,200\" stroke=\"rgba(128,0,255,0.2)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M300,300 Q500,150 700,300 T1100,300\" stroke=\"rgba(128,0,255,0.15)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M100,400 Q300,250 500,400 T900,400\" stroke=\"rgba(128,0,255,0.1)\" stroke-width=\"5\" fill=\"none\"/></svg>');\n      position: relative;\n      color: white;\n      display: flex;\n      flex-direction: column;\n    }\n    .header {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-bottom: 1px solid rgba(128,0,255,0.3);\n    }\n    .footer {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-top: 1px solid rgba(128,0,255,0.3);\n      margin-top: auto;\n    }\n    .content {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding: 40px;\n      position: relative;\n      z-index: 1;\n    }\n    .logo {\n      height: 60px;\n      margin: 0 10px;\n    }\n    .title {\n      font-size: 60px;\n      font-weight: bold;\n      margin-bottom: 40px;\n      text-align: center;\n      background: linear-gradient(45deg, #ffffff, #a64dff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 10px rgba(166, 77, 255, 0.3);\n    }\n    .solution-content {\n      display: flex;\n      flex-direction: column;\n      gap: 30px;\n    }\n    .solution-point {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 15px;\n    }\n    .bullet {\n      color: #a64dff;\n      font-size: 24px;\n      margin-right: 15px;\n      margin-top: 5px;\n    }\n    .point-text {\n      font-size: 24px;\n      color: white;\n      line-height: 1.5;\n    }\n    .solution-diagram {\n      display: flex;\n      justify-content: center;\n      margin: 20px 0;\n    }\n    .diagram-container {\n      width: 80%;\n      height: 200px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      display: flex;\n      align-items: center;\n      justify-content: space-around;\n      padding: 10px;\n    }\n    .diagram-element {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n    }\n    .diagram-icon {\n      width: 60px;\n      height: 60px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-bottom: 10px;\n    }\n    .diagram-text {\n      font-size: 16px;\n      color: white;\n    }\n    .diagram-arrow {\n      width: 40px;\n      height: 40px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      color: #a64dff;\n      font-size: 24px;\n    }\n    .advantages {\n      display: flex;\n      justify-content: space-between;\n      margin-top: 20px;\n    }\n    .advantage-box {\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 15px;\n      width: 30%;\n      text-align: center;\n    }\n    .advantage-title {\n      font-size: 20px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 10px;\n    }\n    .advantage-description {\n      font-size: 16px;\n      color: white;\n    }\n    .decoration {\n      position: absolute;\n      width: 100px;\n      height: 100px;\n      opacity: 0.5;\n    }\n    .decoration.top-right {\n      top: 100px;\n      right: 100px;\n      transform: rotate(45deg);\n    }\n    .decoration.bottom-left {\n      bottom: 100px;\n      left: 100px;\n      transform: rotate(-45deg);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"header\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n    \n    <div class=\"content\">\n      <h1 class=\"title\">SOLUTION OVERVIEW</h1>\n      \n      <div class=\"solution-content\">\n        <div class=\"solution-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Summarize your solution in one or two clear lines.</div>\n        </div>\n        <div class=\"solution-point\">\n          <div class=\"bullet\"></div>\n          <div class=\"point-text\">An AI-powered Smart Farming Ecosystem that combines mobile app technology with IoT sensors to enable data-driven precision agriculture, optimizing resource use and maximizing crop yields.</div>\n        </div>\n        \n        <div class=\"solution-diagram\">\n          <div class=\"diagram-container\">\n            <div class=\"diagram-element\">\n              <div class=\"diagram-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n                </svg>\n              </div>\n              <div class=\"diagram-text\">IoT Sensors</div>\n            </div>\n            <div class=\"diagram-arrow\">→</div>\n            <div class=\"diagram-element\">\n              <div class=\"diagram-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M4 5c0-1.1.9-2 2-2h12c1.1 0 2 .9 2 2v14c0 1.1-.9 2-2 2H6c-1.1 0-2-.9-2-2V5zm3.5 7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5-1.5.67-1.5 1.5zM12 5c-.83 0-1.5.67-1.5 1.5S11.17 8 12 8s1.5-.67 1.5-1.5S12.83 5 12 5zm5.5 7c0 .83.67 1.5 1.5 1.5s1.5-.67 1.5-1.5-.67-1.5-1.5-1.5-1.5.67-1.5 1.5z\"/>\n                </svg>\n              </div>\n              <div class=\"diagram-text\">AI Processing</div>\n            </div>\n            <div class=\"diagram-arrow\">→</div>\n            <div class=\"diagram-element\">\n              <div class=\"diagram-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z\"/>\n                </svg>\n              </div>\n              <div class=\"diagram-text\">Mobile App</div>\n            </div>\n            <div class=\"diagram-arrow\">→</div>\n            <div class=\"diagram-element\">\n              <div class=\"diagram-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"30\" height=\"30\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/>\n                </svg>\n              </div>\n              <div class=\"diagram-text\">Farmer Action</div>\n            </div>\n          </div>\n        </div>\n        \n        <div class=\"solution-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Explain its core functionality and how it effectively addresses the problem.</div>\n        </div>\n        <div class=\"solution-point\">\n          <div class=\"bullet\"></div>\n          <div class=\"point-text\">The system combines real-time soil monitoring through IoT sensors with AI-powered analytics to provide actionable insights and recommendations to farmers. It enables precise resource application (water, fertilizer) based on actual needs rather than estimates, early detection of crop issues before visible symptoms appear, and remote control of irrigation systems. This transforms traditional reactive farming into proactive, data-driven agriculture.</div>\n        </div>\n        \n        <div class=\"solution-point\">\n          <div class=\"bullet\">•</div>\n          <div class=\"point-text\">Highlight the main advantages and what sets it apart from existing solutions.</div>\n        </div>\n        \n        <div class=\"advantages\">\n          <div class=\"advantage-box\">\n            <div class=\"advantage-title\">Integrated Approach</div>\n            <div class=\"advantage-description\">Seamlessly connects monitoring, analysis, and control in one ecosystem, unlike fragmented solutions that address only parts of the farming process</div>\n          </div>\n          <div class=\"advantage-box\">\n            <div class=\"advantage-title\">Accessibility</div>\n            <div class=\"advantage-description\">Designed for farmers of all technical backgrounds with intuitive interface and minimal learning curve, making advanced technology accessible</div>\n          </div>\n          <div class=\"advantage-box\">\n            <div class=\"advantage-title\">Scalability</div>\n            <div class=\"advantage-description\">Modular design allows farmers to start with basic features and add sensors and capabilities as needed, with future expansion to satellite integration</div>\n          </div>\n        </div>\n      </div>\n      \n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration top-right\">\n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwLDUwIDUwLDkwIDEwLDUwIiBmaWxsPSJub25lIiBzdHJva2U9IiNhNjRkZmYiIHN0cm9rZS13aWR0aD0iMyIvPjwvc3ZnPg==\" alt=\"Decoration\" class=\"decoration bottom-left\">\n    </div>\n    \n    <div class=\"footer\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n  </div>\n</body>\n</html>\n"}],"outline":[{"id":"title_slide","title":"Smart Farming Ecosystem: Revolutionizing Agriculture","summary":"Title slide introducing the Smart Farming Ecosystem proposal."},{"id":"problem","title":"The Problem: Agriculture at a Crossroads","summary":"Outlines the critical problems in current agriculture: unsustainability, climate change, inefficiency."},{"id":"solution","title":"Our Solution: The Smart Farming Ecosystem","summary":"Presents the integrated Smart Farming Ecosystem solution, including sensors, AI, mobile app, and hardware."},{"id":"tech_stack","title":"Technology Stack: Powering the Ecosystem","summary":"Details the proposed technology stack for the mobile app, backend, database, and cloud hosting."},{"id":"features","title":"Features","summary":"Describes the key features and functionalities of the Smart Farming Ecosystem."},{"id":"target_audience","title":"Target Audience and Market Scope","summary":"Defines the target audience and market scope for the Smart Farming Ecosystem."},{"id":"challenges","title":"Challenges Faced & Takeaways","summary":"Outlines challenges faced during development and key takeaways."},{"id":"future_scope","title":"Future Scope & Roadmap","summary":"Describes the phased roadmap and long-term vision for the ecosystem's growth and future capabilities."},{"id":"blank_slide","title":"Team Details","summary":"A blank placeholder slide as requested."}],"title":"Smart Farming Ecosystem Proposal - ComSoc HackX 2025"}