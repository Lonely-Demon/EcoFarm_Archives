padding: 0;\n      height: 100%;\n      overflow: hidden;\n      font-family: 'Arial', sans-serif;\n    }\n    .slide {\n      width: 1440px;\n      height: 810px;\n      background: #000;\n      background-image: url('data:image/svg+xml;utf8,<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1440\" height=\"810\" viewBox=\"0 0 1440 810\"><rect width=\"1440\" height=\"810\" fill=\"black\"/><path d=\"M0,0 L1440,0 L1440,810 L0,810 Z\" fill=\"black\"/><path d=\"M200,200 Q400,50 600,200 T1000,200\" stroke=\"rgba(128,0,255,0.2)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M300,300 Q500,150 700,300 T1100,300\" stroke=\"rgba(128,0,255,0.15)\" stroke-width=\"5\" fill=\"none\"/><path d=\"M100,400 Q300,250 500,400 T900,400\" stroke=\"rgba(128,0,255,0.1)\" stroke-width=\"5\" fill=\"none\"/></svg>');\n      position: relative;\n      color: white;\n      display: flex;\n      flex-direction: column;\n    }\n    .header {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-bottom: 1px solid rgba(128,0,255,0.3);\n    }\n    .footer {\n      height: 80px;\n      background-color: rgba(0,0,0,0.7);\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      padding: 0 20px;\n      border-top: 1px solid rgba(128,0,255,0.3);\n      margin-top: auto;\n    }\n    .content {\n      flex: 1;\n      display: flex;\n      flex-direction: column;\n      padding: 40px;\n      position: relative;\n      z-index: 1;\n    }\n    .logo {\n      height: 60px;\n      margin: 0 10px;\n    }\n    .title {\n      font-size: 60px;\n      font-weight: bold;\n      margin-bottom: 40px;\n      text-align: center;\n      background: linear-gradient(45deg, #ffffff, #a64dff);\n      -webkit-background-clip: text;\n      -webkit-text-fill-color: transparent;\n      text-shadow: 0 0 10px rgba(166, 77, 255, 0.3);\n    }\n    .challenges-content {\n      display: flex;\n      flex-direction: column;\n      gap: 30px;\n    }\n    .challenges-point {\n      display: flex;\n      align-items: flex-start;\n      margin-bottom: 15px;\n    }\n    .bullet {\n      color: #a64dff;\n      font-size: 24px;\n      margin-right: 15px;\n      margin-top: 5px;\n    }\n    .point-text {\n      font-size: 24px;\n      color: white;\n      line-height: 1.5;\n    }\n    .challenges-grid {\n      display: grid;\n      grid-template-columns: 1fr 1fr;\n      gap: 30px;\n      margin-top: 20px;\n    }\n    .challenge-card {\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n      display: flex;\n      flex-direction: column;\n    }\n    .challenge-title {\n      font-size: 22px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n    }\n    .challenge-description {\n      font-size: 18px;\n      color: white;\n      margin-bottom: 15px;\n    }\n    .solution-title {\n      font-size: 18px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 10px;\n    }\n    .solution-description {\n      font-size: 16px;\n      color: white;\n    }\n    .learnings {\n      margin-top: 30px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border: 1px solid rgba(166, 77, 255, 0.5);\n      border-radius: 10px;\n      padding: 20px;\n    }\n    .learnings-title {\n      font-size: 24px;\n      font-weight: bold;\n      color: #a64dff;\n      margin-bottom: 15px;\n      text-align: center;\n    }\n    .learnings-list {\n      display: flex;\n      justify-content: space-between;\n    }\n    .learning-item {\n      width: 30%;\n      text-align: center;\n      padding: 15px;\n      background-color: rgba(166, 77, 255, 0.1);\n      border-radius: 10px;\n    }\n    .learning-icon {\n      width: 50px;\n      height: 50px;\n      background-color: rgba(166, 77, 255, 0.2);\n      border-radius: 50%;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0 auto 15px;\n    }\n    .learning-text {\n      font-size: 16px;\n      color: white;\n    }\n    .decoration {\n      position: absolute;\n      width: 100px;\n      height: 100px;\n      opacity: 0.5;\n    }\n    .decoration.top-right {\n      top: 100px;\n      right: 100px;\n      transform: rotate(45deg);\n    }\n    .decoration.bottom-left {\n      bottom: 100px;\n      left: 100px;\n      transform: rotate(-45deg);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"slide\">\n    <div class=\"header\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"Hack Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE ComSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"IEEE CTSoc Logo\" class=\"logo\">\n      <img src=\"data:image/svg+xml;base64,\" alt=\"University Logo\" class=\"logo\">\n    </div>\n    \n    <div class=\"content\">\n      <h1 class=\"title\">CHALLENGES FACED & TAKEAWAYS</h1>\n      \n      <div class=\"challenges-content\">\n        <div class=\"challenges-grid\">\n          <div class=\"challenge-card\">\n            <div class=\"challenge-title\">Sensor Integration Complexity</div>\n            <div class=\"challenge-description\">Integrating diverse sensor types with varying communication protocols and data formats created significant technical hurdles</div>\n            <div class=\"solution-title\">How we solved it:</div>\n            <div class=\"solution-description\">Created a standardized API layer that abstracts the underlying sensor communication, enabling seamless data flow regardless of sensor type or protocol</div>\n          </div>\n          \n          <div class=\"challenge-card\">\n            <div class=\"challenge-title\">Technical Accessibility</div>\n            <div class=\"challenge-description\">Ensuring system usability for farmers with limited technical literacy while maintaining advanced functionality</div>\n            <div class=\"solution-title\">How we solved it:</div>\n            <div class=\"solution-description\">Implemented an intuitive UI with visual cues, minimal text, and progressive disclosure of advanced features, with extensive user testing with actual farmers</div>\n          </div>\n          \n          <div class=\"challenge-card\">\n            <div class=\"challenge-title\">AI Model Training Limitations</div>\n            <div class=\"challenge-description\">Developing accurate AI models with limited initial training data for crop recommendations and disease detection</div>\n            <div class=\"solution-title\">How we solved it:</div>\n            <div class=\"solution-description\">Used transfer learning from existing agricultural models and synthetic data generation techniques to augment training datasets, with continuous improvement as real data accumulates</div>\n          </div>\n          \n          <div class=\"challenge-card\">\n            <div class=\"challenge-title\">Mobile Performance Constraints</div>\n            <div class=\"challenge-description\">Balancing feature richness with performance on low-end mobile devices common in rural farming communities</div>\n            <div class=\"solution-title\">How we solved it:</div>\n            <div class=\"solution-description\">Optimized app through efficient code, progressive loading, offline functionality, and adaptive UI that scales based on device capabilities</div>\n          </div>\n        </div>\n        \n        <div class=\"learnings\">\n          <div class=\"learnings-title\">Key Takeaways</div>\n          <div class=\"learnings-list\">\n            <div class=\"learning-item\">\n              <div class=\"learning-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\"/>\n                </svg>\n              </div>\n              <div class=\"learning-text\">User-centered design is critical for agricultural technology adoption - solutions must be designed with and for farmers, not just for them</div>\n            </div>\n            \n            <div class=\"learning-item\">\n              <div class=\"learning-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z\"/>\n                </svg>\n              </div>\n              <div class=\"learning-text\">Modular architecture enables easier scaling and maintenance, allowing farmers to start small and expand their system over time</div>\n            </div>\n            \n            <div class=\"learning-item\">\n              <div class=\"learning-icon\">\n                <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"#a64dff\">\n                  <path d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z\"/>\n                </svg>\n              </div>\n              <div class=\"learning-text\">Field testing with actual farmers provides invaluable insights that laboratory development cannot replicate</div>\n            </div>\n          </div>\n        </div>\n      </div>\n      \n      <img src=\"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxMDAgMTAwIj48cG9seWdvbiBwb2ludHM9IjUwLDEwIDkwL